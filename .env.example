# Ledgerly PWA Finance Tracker - Environment Configuration Template
# Copy this file to .env and fill in your actual values:

# Google Apps Script Web App Deployment URL
PWA_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Google Sheet Source URL (optional reference)
GSHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit?usp=sharing"

# Local Development Server Port
PORT=8080
